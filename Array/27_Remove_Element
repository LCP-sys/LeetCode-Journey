//自己想的，類似26題，同樣利用雙指標法把有效資訊放到前面
class Solution {
public:
    int removeElement(vector<int>& nums, int val) {
        int slow=0;
        int fast=0;
        while(fast<nums.size()){
            if(nums[fast]!=val){
                nums[slow]=nums[fast];
                ++slow;
            }
            ++fast;
        }
        return slow;
    }
};
//邏輯一樣的STL模板
class Solution {
public:
    int removeElement(vector<int>& nums, int val) {
        return std::remove(nums.begin(), nums.end(), val) - nums.begin();
    }
};