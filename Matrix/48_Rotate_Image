//矩陣幾何翻轉法
//順時針90°=左上到右下對角線翻轉+水平翻轉
class Solution {
public:
    void rotate(vector<vector<int>>& matrix) {
        for(int i=0;i<matrix.size();i++)
            for(int j=i;j<matrix.size();j++)
                swap(matrix[i][j],matrix[j][i]);
        for(int i=0;i<matrix.size();i++)
            std::reverse(matrix[i].begin(),matrix[i].end());
    }
};