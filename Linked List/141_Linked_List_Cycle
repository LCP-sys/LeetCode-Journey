//自己想的用unordered_set記錄所有pointer
class Solution {
public:
    bool hasCycle(ListNode *head) {
        unordered_set<ListNode*> hash;
        while(head){
            if(hash.count(head))
                return true;
            hash.emplace(head);
            head=head->next;
        }
        return false;
    }
};
//參考解答:快慢指標
//邏輯:若有循環則fast必定能追上slow，反之比定走到終點NULL
class Solution {
public:
    bool hasCycle(ListNode *head) {
        ListNode *fast=head;
        ListNode *slow=head;
        while(fast && fast->next){
            fast=fast->next->next;
            slow=slow->next;
            if(fast==slow)
                 return true;
        }
        return false;
    }
};