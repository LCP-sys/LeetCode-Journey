private:
    const string index[8]={"abc","def","ghi","jkl","mno","pqrs","tuv","wxyz"};

public:
    void path(string &digits,vector<string> &ans,string &s,int pos){
        if(pos>=digits.size()){
            ans.push_back(s);
            return;
        }
        int num=digits[pos]-'0'-2;
        for(int i=0;i<index[num].size();i++){
            s.push_back(index[num][i]);
            path(digits,ans,s,pos+1);
            s.pop_back();
        }
    }
    vector<string> letterCombinations(string digits) {
        vector<string> ans;
        string s;
        path(digits,ans,s,0);
        return ans;
    }
};