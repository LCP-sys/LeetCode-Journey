class Solution {
public:
    int reverseBits(int n) {
        int ans=0;
        for(int i=0;i<31;i++){
            ans+=(n&1)<<(31-i);
            n>>=1;
        }
        return ans;
    }
};
//參考解答
//不使用+=用OR確保位元合併邏輯正確
class Solution {
public:
    int reverseBits(int n) {
        int ans=0;
        for(int i=0;i<32;i++){
            ans<<=1;
            ans|=(n&1);
            n>>=1;
        }
        return ans;
    }
};